{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rewriteRelativeImportExtensions": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"]
}
