{
	"name": "iteration-trace-collector",
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Iteration-ai/trace-vault.git",
		"directory": "packages/cli"
	},
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"LICENSE",
		"NOTICE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "pnpm --filter iteration-trace-contracts build && tsc -p tsconfig.json --noEmit && node build.mjs && tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"iteration-trace-contracts": "workspace:*",
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@secretlint/core": "13.0.6",
		"@secretlint/profiler": "13.0.6",
		"@secretlint/secretlint-rule-preset-recommend": "13.0.6",
		"esbuild": "0.28.2"
	}
}
