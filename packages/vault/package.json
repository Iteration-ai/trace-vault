{
	"name": "trace-vault",
	"version": "0.1.1",
	"private": true,
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"trace-vault-server": "./dist/main.js"
	},
	"scripts": {
		"build": "pnpm --filter iteration-trace-contracts build && pnpm --filter iteration-trace-postgres build && node build.mjs && tsc --noEmit",
		"start": "node dist/main.js",
		"test": "node --import=tsx --test src/*.test.ts"
	},
	"dependencies": {
		"drizzle-orm": "0.45.3",
		"iteration-trace-contracts": "workspace:*",
		"iteration-trace-postgres": "workspace:*",
		"pg": "8.23.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"esbuild": "0.28.2",
		"postcss": "8.5.23",
		"typescript": "5.9.3"
	}
}
